# SafeNest 비상 대응 설정 예시. 실제 값은 Pi의 별도 환경 파일에만 둡니다.

# Production is the default. Set true only for an explicit competition/demo run;
# this enables the manual LCD control and mock 119 simulation routes.
SAFENEST_DEMO_MODE=false

# 관리자 포털(/admin) 계정. 저장소에는 기본 계정이 없습니다.
# 아래 두 값을 모두 설정하기 전까지 /admin 로그인은 항상 거부됩니다
# (나머지 런타임과 API는 정상 동작). 실제 값은 커밋하지 마십시오.
SAFENEST_ADMIN_ID=your_admin_id
SAFENEST_ADMIN_PASSWORD=change_me
# 미설정 시 프로세스마다 무작위 서명 키를 생성합니다(재기동하면 토큰 무효).
SAFENEST_AUTH_SECRET=

# SMS provider: 현재 기본 adapter는 Naver Cloud SENS입니다.
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SERVICE_ID=
SMS_FROM_NUMBER=
SMS_API_BASE_URL=https://sens.apigw.ntruss.com
SMS_TIMEOUT_SECONDS=8
MANAGER_PHONE_NUMBER=
MANAGER_NAME=안전 담당자

# 60초 이내 반복 SMS를 backend에서 차단합니다.
SAFENEST_SMS_COOLDOWN_SECONDS=60

# auto: RPi.GPIO가 있으면 GPIO, 없으면 명시적인 mock_fallback
# mock: 개발 PC/시연 준비용 mock, off: 부저 비활성
SAFENEST_GPIO_MODE=auto
SAFENEST_BUZZER_GPIO_PIN=18
SAFENEST_BUZZER_FREQUENCY_HZ=880

# Offline risk TTS. --install downloads the Korean Piper ko_KR-kss-medium voice,
# and auto prefers it over eSpeak. PIPER_MODEL may override that default model.
# AUDIO_DEVICE is an optional ALSA target such as plughw:CARD=Device,DEV=0;
# empty uses the default.
SAFENEST_TTS_ENABLED=1
SAFENEST_TTS_MODE=auto
SAFENEST_TTS_AUDIO_DEVICE=
SAFENEST_TTS_PIPER_MODEL=
SAFENEST_TTS_WARNING_COOLDOWN_SECONDS=60
SAFENEST_TTS_DANGER_COOLDOWN_SECONDS=30
SAFENEST_TTS_COMMAND_TIMEOUT_SECONDS=30

# Sensor timing. ESP32 reception remains continuous; only usable CO2 state/data
# adoption is limited to once per minute. Final risk publication is scheduled
# separately by backend/run_backend.py (default: 15 seconds).
SAFENEST_CO2_UPDATE_INTERVAL_SECONDS=60

# Persistent rolling sensor dataset. Decimal GB values are used (1 GB=10^9 B).
SAFENEST_SENSOR_DATA_ENABLED=true
# Empty means data/ under this repository root; set an absolute Pi path when desired.
# Do not require a developer Mac absolute path for normal startup.
SAFENEST_SENSOR_DATA_ROOT=

# Optional virtualenv override. Default is <repository>/.venv, not ~/.venv.
SAFENEST_VENV_PATH=

# Runtime listener defaults are CLI flags on backend/run_backend.py, not env:
#   --api-host 0.0.0.0 --api-port 8000
#   --sensor-host 0.0.0.0 --sensor-port 9000
#   --db-path data/safenest.db
# Thermal UDP remains env-configurable below.
SAFENEST_SENSOR_DATA_MAX_GB=10
SAFENEST_MIN_FREE_DISK_GB=2
SAFENEST_MMWAVE_DATA_MAX_GB=1
SAFENEST_CO2_DATA_MAX_GB=0.25
SAFENEST_THERMAL_DATA_MAX_GB=8.5
SAFENEST_SENSOR_DATA_QUEUE_CAPACITY=512
SAFENEST_THERMAL_BATCH_FRAMES=64
SAFENEST_THERMAL_FLUSH_SECONDS=2
SAFENEST_SENSOR_CLEANUP_INTERVAL_SECONDS=30

# Thermal-44 uses an independent chunked UDP channel. Scalar sensors remain on
# SafeNest TCP v1 port 9000.
SAFENEST_THERMAL_UDP_HOST=0.0.0.0
SAFENEST_THERMAL_UDP_PORT=5005
SAFENEST_THERMAL_UDP_FRAME_TIMEOUT_SECONDS=0.5
SAFENEST_THERMAL_UDP_MAX_PENDING_FRAMES=8
